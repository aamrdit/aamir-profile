# Copy to .env and fill. Never commit .env.

# Resend: forwards enquiries to aamir.butt@outlook.com and stores nothing
# (FR-911). Requires aamirbutt.com verified as a sending domain.
RESEND_API_KEY=

# Cloudflare Turnstile (FR-910). Without these the enquiry form falls back to
# honeypot-only spam protection.
TURNSTILE_SECRET=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Plausible, cookieless (Section 13). The script tag renders ONLY when this is
# set, so local and CI runs emit no third-party request and 01-page-load's
# zero-failed-requests assertion holds. See DECISIONS.md, C7.
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: point Playwright and Lighthouse CI at a deployed preview instead of
# the local `nuxt preview` server.
BASE_URL=
